---------------------------------------------------
-- 🧠 RAID PRIORITY SYSTEM (NUMÉRICO)
---------------------------------------------------

local RaidPriority = {
    ["Trial Easy"] = 1,
    ["Tempest Invasion"] = 2,
    ["Dragon Defense"] = 3
}

local function GetPriority(mode)
    return RaidPriority[mode] or 999
end

local function CanJoinRaid(targetMode)
    local current = Omni.Data.Gamemode

    -- si no estás en nada → puedes entrar
    if not current or current == "None" then
        return true
    end

    -- si ya estás en ese mismo → no
    if current == targetMode then
        return false
    end

    -- prioridad: solo entra si es MÁS IMPORTANTE
    return GetPriority(targetMode) < GetPriority(current)
end

