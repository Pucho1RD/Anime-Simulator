task.spawn(function()
    local npcIndex = 1
    local partIndex = 1

    while true do
        task.wait(0.6)

        if PauseMapFarm then continue end

        local char = game.Players.LocalPlayer.Character
        if not char then continue end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end

        ---------------------------------------------------
        -- SOLO 1
        ---------------------------------------------------
        if TPEnabled and not TPAll then
            if SelectedNPC1 then
                local group = NPCGroups[SelectedNPC1]

                if group and #group > 0 then
                    for _, part in ipairs(group) do
                        if IsAlive(part) then
                            hrp.CFrame = part.CFrame + Vector3.new(0,3,0)
                            break
                        end
                    end
                end
            end
        end

        ---------------------------------------------------
        -- TODOS
        ---------------------------------------------------
        if TPAll then
            local targets = {}
            if SelectedNPC1 then table.insert(targets, SelectedNPC1) end
            if SelectedNPC2 then table.insert(targets, SelectedNPC2) end

            if #targets == 0 then continue end
            if npcIndex > #targets then npcIndex = 1 end

            local group = NPCGroups[targets[npcIndex]]

            if group and #group > 0 then
                local found = false

                for i = partIndex, #group do
                    local part = group[i]

                    if IsAlive(part) then
                        hrp.CFrame = part.CFrame + Vector3.new(0,3,0)
                        partIndex = i + 1
                        found = true
                        break
                    end
                end

                if not found then
                    partIndex = 1
                    npcIndex += 1
                end
            else
                npcIndex += 1
            end
        end
    end
end)
