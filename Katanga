local RS = game:GetService("ReplicatedStorage")
local Omni = require(RS:WaitForChild("Omni"))

local AutoSkill = false

Others:CreateToggle({
    Name = "Auto Skill Tree (Cheapest First)",
    Callback = function(state)
        AutoSkill = state
    end
})

local function parsePrice(v)
    if typeof(v) == "number" then
        return v
    end
    if type(v) ~= "string" then
        return 0
    end
    return tonumber(v:gsub("%D","")) or 0
end

task.spawn(function()
    while task.wait(2) do
        if not AutoSkill then continue end

        local treeName = "Pirate Evolution"

        local treeModule = require(
            RS:WaitForChild("Omni")
              :WaitForChild("Shared")
              :WaitForChild("SkillTree")
              :WaitForChild(treeName)
        )

        local upgrades = treeModule.Upgrades
        local playerData = Omni.Data.SkillTree[treeName] or {}

        local candidates = {}

        for name, data in pairs(upgrades) do
            if not playerData[name] then
                table.insert(candidates, {
                    Name = name,
                    Price = parsePrice(data.Price.Amount)
                })
            end
        end

        table.sort(candidates, function(a,b)
            return a.Price < b.Price
        end)

        local nextUpgrade = candidates[1]

        if nextUpgrade then
            RS.BridgeNet.dataRemoteEvent:FireServer({
                {
                    "General",
                    "SkillTree",
                    "Unlock",
                    treeName,
                    nextUpgrade.Name,
                    n = 5
                },
                "\2"
            })
        end
    end
end)


