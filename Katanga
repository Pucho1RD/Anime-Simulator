local function GetZones(mapName)
    local zones = {}
    local map = WorldFolder:FindFirstChild(mapName)

    if not map then return {"1"} end

    for _, obj in pairs(map:GetChildren()) do
        if obj.Name == "1" or obj.Name == "2" then
            table.insert(zones, obj.Name)
        end
    end

    return zones
end

