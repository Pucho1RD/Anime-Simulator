-- 🔍 buscar humanoid real
local function GetRealHumanoid(part)
    if not part then return nil end

    local name = part.Name

    for _, model in pairs(ClientEnemies:GetChildren()) do
        if model.Name == name then
            local hum = model:FindFirstChildOfClass("Humanoid")
            if hum then
                return hum
            end
        end
    end

    return nil
end

-- ❤️ check de vida REAL
local function IsAlive(part)
    local hum = GetRealHumanoid(part)

    if hum then
        return hum.Health > 0
    end

    return true -- fallback
end

